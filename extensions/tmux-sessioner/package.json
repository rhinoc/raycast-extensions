{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "tmux-sessioner",
  "title": "Tmux Sessioner",
  "description": "Quick Tmux Session Switcher",
  "icon": "command-icon.png",
  "author": "louishuyng",
  "contributors": [
    "sxn",
    "jasonshanks",
    "guide",
    "janwvjaarsveld"
  ],
  "categories": [
    "Developer Tools"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Manage Tmux",
      "description": "Browse tmux sessions, windows, and create sessions from one command",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "terminalAppBundleId",
      "title": "Terminal Application",
      "description": "Select which terminal app to use when opening tmux sessions",
      "type": "dropdown",
      "required": false,
      "default": "com.apple.Terminal",
      "data": [
        {
          "title": "Terminal",
          "value": "com.apple.Terminal"
        },
        {
          "title": "iTerm",
          "value": "com.googlecode.iterm2"
        },
        {
          "title": "Ghostty",
          "value": "com.mitchellh.ghostty"
        },
        {
          "title": "Warp",
          "value": "dev.warp.Warp-Stable"
        },
        {
          "title": "WezTerm",
          "value": "com.github.wez.wezterm"
        },
        {
          "title": "Alacritty",
          "value": "org.alacritty"
        },
        {
          "title": "kitty",
          "value": "net.kovidgoyal.kitty"
        }
      ]
    },
    {
      "name": "defaultDirectory",
      "description": "Default directory for new tmux session",
      "title": "New Session Default Directory",
      "placeholder": "Select a directory",
      "type": "directory",
      "required": false
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.88.4",
    "@raycast/utils": "^1.18.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "1.0.11",
    "@types/node": "^20.8.10",
    "@types/react": "^18.2.27",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "react": "^18.2.0",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}

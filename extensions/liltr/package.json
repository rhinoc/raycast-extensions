          "value": "pt-PT"
        },
        {
          "title": "🇮🇹 Italiano",
          "value": "it-IT"
        },
        {
          "title": "🇩🇪 Deutsch",
          "value": "de-DE"
        },
        {
          "title": "🇹🇷 Türkçe",
          "value": "tr-TR"
        },
        {
          "title": "🇹🇭 ไทย",

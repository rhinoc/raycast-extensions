{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "liltr",
  "title": "Liltr",
  "version": "0.0.0",
  "description": "Translate text directly inside Raycast with liltr providers",
  "icon": "liltr-icon.png",
  "author": "rhinoc",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Productivity",
    "Developer Tools"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "translate",
      "title": "Translate",
      "description": "Type text and translate it directly inside Raycast",
      "mode": "view"
    },
    {
      "name": "translate-selected-text",
      "title": "Translate Selection",
      "description": "Load selected text from the frontmost app and translate it inside Raycast",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "runtimeMode",
      "title": "Runtime Mode",
      "description": "Choose whether liltr runs inside Raycast or opens the standalone liltr app.",
      "type": "dropdown",
      "required": false,
      "default": "raycast",
      "data": [
        {
          "title": "Raycast",
          "value": "raycast"
        },
        {
          "title": "Liltr App",
          "value": "liltr-app"
        }
      ]
    },
    {
      "name": "defaultProvider",
      "title": "Default Provider",
      "description": "Translation provider used when a command opens.",
      "type": "dropdown",
      "required": false,
      "default": "niutrans",
      "data": [
        {
          "title": "NiuTrans",
          "value": "niutrans"
        },
        {
          "title": "Volcengine",
          "value": "volcengine"
        },
        {
          "title": "Baidu",
          "value": "baidu"
        },
        {
          "title": "Ali",
          "value": "ali"
        },
        {
          "title": "Ollama",
          "value": "ollama"
        }
      ]
    },
    {
      "name": "defaultSourceLanguage",
      "title": "Default Source Language",
      "description": "Starting source language for translation.",
      "type": "dropdown",
      "required": false,
      "default": "auto",
      "data": [
        {
          "title": "Auto Detect",
          "value": "auto"
        },
        {
          "title": "🇺🇸 English",
          "value": "en-US"
        },
        {
          "title": "🇨🇳 简体中文",
          "value": "zh-CN"
        },
        {
          "title": "🇯🇵 日本語",
          "value": "ja-JP"
        },
        {
          "title": "🇰🇷 한국어",
          "value": "ko-KR"
        },
        {
          "title": "🇫🇷 Français",
          "value": "fr-FR"
        },
        {
          "title": "🇪🇸 Español",
          "value": "es-ES"
        },
        {
          "title": "🇵🇹 Português",
          "value": "pt-PT"
        },
        {
          "title": "🇮🇹 Italiano",
          "value": "it-IT"
        },
        {
          "title": "🇩🇪 Deutsch",
          "value": "de-DE"
        },
        {
          "title": "🇹🇷 Türkçe",
          "value": "tr-TR"
        },
        {
          "title": "🇹🇭 ไทย",
          "value": "th-TH"
        },
        {
          "title": "🇸🇦 العربية",
          "value": "ar-AE"
        },
        {
          "title": "🇮🇩 Bahasa Indonesia",
          "value": "id-ID"
        },
        {
          "title": "🇲🇾 Bahasa Melayu",
          "value": "ms-MY"
        },
        {
          "title": "🇻🇳 Tiếng Việt",
          "value": "vi-VN"
        }
      ]
    },
    {
      "name": "primaryLanguage",
      "title": "Primary Language",
      "description": "Preferred target language when liltr needs a default.",
      "type": "dropdown",
      "required": false,
      "default": "zh-CN",
      "data": [
        {
          "title": "🇺🇸 English",
          "value": "en-US"
        },
        {
          "title": "🇨🇳 简体中文",
          "value": "zh-CN"
        },
        {
